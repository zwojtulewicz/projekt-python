gender = input("Enter your gender (f/m): ").strip().lower()
pal = float(input("Enter your PAL (e.g., 1.2–2.4): "))
weight = float(input("Enter your weight in kilograms: "))
height = float(input("Enter your height in centimeters: "))
age = int(input("Enter your age: "))

#Basal Metabolic Rate
def bmr(gender: str, weight: float, height: float, age: int) -> float:
    if gender == "f":
        return 10 * weight + 6.25 * height - 5 * age - 161
    elif gender == "m":
        return 10 * weight + 6.25 * height - 5 * age + 5
    else:
        raise ValueError("Invalid gender. Use 'f' for female or 'm' for male.")

#Total Daily Energy Expenditure
def tdee(bmr_value: float, pal: float) -> float:
    return bmr_value * pal

bmr_value = bmr(gender, weight, height, age)
tdee_value = tdee(bmr_value, pal)

print(f"BMR: {bmr_value:.2f} kcal/day")
print(f"TDEE: {tdee_value:.2f} kcal/day")
