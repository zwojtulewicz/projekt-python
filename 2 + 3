import streamlit as st

##### logika biznesowa musi byc na poczatku!! #####

class User:
    def __init__(self, gender, age, weight, height, activity, restrictions, lifestyle, target):
        self.gender = gender
        self.age = age
        self.weight = weight
        self.height = height
        self.activity = activity
        self.restrictions = [r.casefold() for r in restrictions]
        self.lifestyle = lifestyle
        self.target = target

    @property
    def gender(self): return self._gender
    @gender.setter
    def gender(self, g):
        valid_gender = ["f", "m"]
        if not isinstance(g, str) or g.casefold() not in valid_gender:
            raise ValueError("Nieprawidłowa płeć")
        self._gender = g.casefold()        

    @property
    def age(self): return self._age
    @age.setter
    def age(self, a):
        if not isinstance(a, int) or a <= 0 or a > 120:
            raise ValueError("Nieprawidłowy wiek")
        self._age = a

    @property
    def weight(self): return self._weight
    @weight.setter
    def weight(self, w):
        if w <= 0 or w > 600:
            raise ValueError("Nieprawidłowa waga")
        self._weight = w

    @property
    def height(self): return self._height
    @height.setter
    def height(self, h):
        if h <= 50 or h > 300:
            raise ValueError("Nieprawidłowy wzrost")
        self._height = h

    @property
    def target(self): return self._target
    @target.setter
    def target(self, t):
        valid_target = ["lose", "gain", "maintain"]
        if not isinstance(t, str) or t.casefold() not in valid_target:
            raise ValueError("Nieprawidłowy cel")
        self._target = t.casefold()
        
    def calculate_bmr(self):
        if self.gender == "f":
            return 10 * self.weight + 6.25 * self.height - 5 * self.age - 161
        else:
            return 10 * self.weight + 6.25 * self.height - 5 * self.age + 5

    def calculate_tdee(self):
        return self.calculate_bmr() * self.activity

    def macros(self, tdee_value):
        if self.target == "lose":
            p_ratio, f_ratio, c_ratio = 0.30, 0.25, 0.45
        elif self.target == "gain":
            p_ratio, f_ratio, c_ratio = 0.20, 0.20, 0.60
        else:
            p_ratio, f_ratio, c_ratio = 0.20, 0.30, 0.50
        
        proteins = (tdee_value * p_ratio) / 4
        fats = (tdee_value * f_ratio) / 9
        carbs = (tdee_value * c_ratio) / 4
        return {
            "Białko (g)": round(proteins),
            "Tłuszcze (g)": round(fats),
            "Węglowodany (g)": round(carbs)
        }

    def minerals(self):
        if self.target == "lose":
            return "Monitoruj poziom magnezu, witamin z grupy B, żelaza i jodu ze względu na deficyt kaloryczny."
        elif self.target == "gain":
            return "Monitoruj cynk, wapń, witaminę D, potas i sód."
        else:
            return "Dla zdrowej diety monitoruj magnez, potas, witaminy B i D oraz kwasy OMEGA-3."

    def recs(self):
        protein_list = ["kurczak", "indyk", "chuda wołowina", "ryby", "jajka", "twaróg", "jogurt grecki", "soczewica", "quinoa", "fasola", "ciecierzyca", "tofu"]
        fat_list = ["oliwa", "orzechy (migdały, włoskie)", "awokado", "nasiona chia", "pestki dyni", "ryby morskie"]
        carb_list = ["kasze", "brązowy ryż", "owies", "chleb pełnoziarnisty", "makaron pełnoziarnisty", "ziemniaki", "bataty", "owoce", "warzywa"]
    
        if "wegańska" in self.restrictions:
            forbidden = ["kurczak", "indyk", "chuda wołowina", "ryby", "jajka", "twaróg", "jogurt grecki", "ryby morskie"]
            protein_list = [p for p in protein_list if p not in forbidden]
            fat_list = [p for p in fat_list if p not in forbidden]
        elif "wegetariańska" in self.restrictions:
            forbidden = ["kurczak", "indyk", "chuda wołowina", "ryby", "ryby morskie"]
            protein_list = [p for p in protein_list if p not in forbidden]
            fat_list = [p for p in fat_list if p not in forbidden]

        if "bezglutenowa" in self.restrictions:
            gluten = ["owies", "chleb pełnoziarnisty", "makaron pełnoziarnisty"]
            carb_list = [p for p in carb_list if p not in gluten]
            carb_list.extend(["chleb bezglutenowy", "makaron kukurydziany/ryżowy", "płatki jaglane"])

        return {"Białka": ", ".join(protein_list), "Tłuszcze": ", ".join(fat_list), "Węglowodany": ", ".join(carb_list)}

def calculate_bmr_simple(gender, weight, height, age):
    if gender == "Kobieta":
        return 10 * weight + 6.25 * height - 5 * age - 161
    return 10 * weight + 6.25 * height - 5 * age + 5

#####reprezentacja graficzna#####

st.title("Asystent Dietetyczny")
tab1, tab2 = st.tabs(["Kalkulator BMR/TDEE", "Planer Dietetyczny"])

##### zakladka 1 - zapotrzebowanie kaloryczne #####

with tab1:
    st.header("Szybkie obliczenia")
    with st.container():
        c1, c2 = st.columns(2)
        with c1:
            g = st.selectbox("Płeć", ["Kobieta", "Mężczyzna"], key="t1_g")
            a = st.number_input("Wiek", 1, 120, 25, key="t1_a")
        with c2:
            w = st.number_input("Waga (kg)", 10.0, 300.0, 70.0, key="t1_w")
            h = st.number_input("Wzrost (cm)", 50.0, 250.0, 170.0, key="t1_h")
        
        p = st.slider("Aktywność (PAL)", 1.2, 2.4, 1.4, 0.1, key="t1_p")

    if st.button("Oblicz BMR i TDEE"):
        bmr_val = calculate_bmr_simple(g, w, h, a)
        tdee_val = bmr_val * p
        st.divider()
        col_res1, col_res2 = st.columns(2)
        col_res1.metric("BMR", f"{bmr_val:.2f} kcal")
        col_res2.metric("TDEE", f"{tdee_val:.2f} kcal")

##### zakladka 2 - rekomendacje mikro i makro #####

with tab2:                    
    st.header("Planer Dietetyczny")
    
    col_z1, col_z2 = st.columns(2) 

    with col_z1: 
        gender_display = st.selectbox("Płeć", ["Mężczyzna", "Kobieta"], key="z_plec")
        gender_val = "m" if gender_display == "Mężczyzna" else "f" 
        
        age_z = st.number_input("Wiek", min_value=1, max_value=120, value=25, key="z_wiek")
        height_z = st.number_input("Wzrost (cm)", min_value=100, max_value=250, value=170, key="z_wzrost")
        weight_z = st.number_input("Waga (kg)", min_value=30.0, max_value=300.0, value=65.0, key="z_waga")

    with col_z2:
        activity_options = {
            "Brak ćwiczeń": 1.2,
            "Lekka aktywność (1-3 dni)": 1.375,
            "Umiarkowana (3-5 dni)": 1.55,
            "Duża (6-7 dni)": 1.725
        }
        act_key = st.selectbox("Aktywność", list(activity_options.keys()), key="z_akt")
        activity_val = activity_options[act_key]

        target_options = {"Schudnąć": "lose", "Utrzymać": "maintain", "Przytyć": "gain"}
        tar_key = st.selectbox("Cel", list(target_options.keys()), key="z_cel")
        target_val = target_options[tar_key]
        
        lifestyle = st.selectbox("Tryb pracy", ["Biurowa", "Fizyczna", "Mieszana"], key="z_praca")

    restrictions = st.multiselect("Restrykcje", ["Bezglutenowa", "Wegetariańska", "Wegańska"], key="z_restr")

    if st.button("Generuj Plan Dietetyczny", type="primary", key="btn_zuzia"):
        try:
            # Tworzenie obiektu klasy User
            user = User(
                gender=gender_val, 
                age=int(age_z), 
                weight=weight_z, 
                height=int(height_z), 
                activity=activity_val, 
                restrictions=restrictions, 
                lifestyle=lifestyle, 
                target=target_val
            )
            
            tdee_value = user.calculate_tdee()

            st.markdown("---")
            st.success(f"🥑 Twoje zapotrzebowanie (TDEE): **{int(tdee_value)} kcal**")
            
            macros = user.macros(tdee_value)
            c1, c2, c3 = st.columns(3)
            c1.metric("Białko", f"{macros['Białko (g)']} g")
            c2.metric("Tłuszcze", f"{macros['Tłuszcze (g)']} g")
            c3.metric("Węglowodany", f"{macros['Węglowodany (g)']} g")

            st.info(f"💡 Porada: {user.minerals()}")
            
            with st.expander("Zobacz polecane produkty"):
                recs = user.recs()
                for k, v in recs.items():
                    st.write(f"**{k}:** {v}")

        except ValueError as e:  
            st.error(f"Błąd danych: {e}")
